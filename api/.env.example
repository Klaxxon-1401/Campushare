# CampusShare API environment configuration
# Copy to .env and fill in values. Never commit the real .env.

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8081,http://localhost:19000,http://localhost:19006

# Campus email domains allowed to register (comma-separated)
CAMPUS_DOMAINS=university.edu,student.university.edu

# Email delivery — Resend (https://resend.com)
# Leave RESEND_API_KEY empty and the API logs emails to the console instead.
# Replace re_xxxxxxxxx with your real key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Verified sender. Until you verify a domain in Resend, only onboarding@resend.dev
# is allowed — and it only delivers to the address your Resend account uses.
EMAIL_FROM=onboarding@resend.dev
# Where `npm run email:test` sends its test message.
EMAIL_TEST_TO=

# Firebase Admin SDK (Week 6+)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Stripe (Week 7+)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
